{
  "name": "@memside-h/memside",
  "version": "0.3.0",
  "license": "MIT",
  "private": false,
  "files": ["src", "opencode-plugin", "tsconfig.json"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "memside": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:live": "cross-env MEMSIDE_RUN_LIVE=1 bun test tests/live-distill.test.ts tests/live-judge.test.ts tests/live-llm-failure-resume.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite",
    "build": "vite build",
    "gen-manifest": "bun run scripts/gen-manifest.ts",
    "build:exe": "bun run build && bun run gen-manifest && bun build --compile --target=bun-windows-x64 --outfile=dist/memside.exe src/exe/launcher.ts",
    "build:installer": "makensis installer/installer.nsi",
    "prepublishOnly": "bun run build",
    "start": "bun run build && bun run scripts/start.ts",
    "dev": "bun run scripts/dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
